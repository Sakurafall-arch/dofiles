	cd /home/arch/.config/quickshell/core/build && $(MAKE) $(MAKESILENT) -f plugin/weather/CMakeFiles/ClavisWeather.dir/build.make plugin/weather/CMakeFiles/ClavisWeather.dir/src/weather_plugin.cpp.o
.PHONY : src/weather_plugin.cpp.o

src/weather_plugin.i: src/weather_plugin.cpp.i
.PHONY : src/weather_plugin.i

# target to preprocess a source file
src/weather_plugin.cpp.i:
	cd /home/arch/.config/quickshell/core/build && $(MAKE) $(MAKESILENT) -f plugin/weather/CMakeFiles/ClavisWeather.dir/build.make plugin/weather/CMakeFiles/ClavisWeather.dir/src/weather_plugin.cpp.i
.PHONY : src/weather_plugin.cpp.i

src/weather_plugin.s: src/weather_plugin.cpp.s
.PHONY : src/weather_plugin.s

# target to generate assembly for a file
src/weather_plugin.cpp.s:
	cd /home/arch/.config/quickshell/core/build && $(MAKE) $(MAKESILENT) -f plugin/weather/CMakeFiles/ClavisWeather.dir/build.make plugin/weather/CMakeFiles/ClavisWeather.dir/src/weather_plugin.cpp.s
.PHONY : src/weather_plugin.cpp.s

