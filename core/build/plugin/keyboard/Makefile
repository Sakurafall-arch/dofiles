	cd /home/arch/.config/quickshell/core/build && $(MAKE) $(MAKESILENT) -f plugin/keyboard/CMakeFiles/ClavisKeyboard.dir/build.make plugin/keyboard/CMakeFiles/ClavisKeyboard.dir/src/keyboard_lock_plugin.cpp.s
.PHONY : src/keyboard_lock_plugin.cpp.s

