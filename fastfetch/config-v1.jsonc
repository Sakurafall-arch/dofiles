{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/home/arch/.config/fastfetch/arch.txt",
    "width": 25,
    "color": {
      "1":"#ffb1c1",
      "2":"#ffb1c1"
    }
  },
    "padding": {
      "top": 1, // Top padding
      "left": 2, // Left padding
      "right": 2 // Right padding
    },
  },
  "display": {
    "separator": " ", // Separator between keys and values
    "color": {
      //"keys": "#e4bdc3", // Key color module名字的颜色
      "title": "#d6c2c4", // Title color 主机名的颜色
      "output": "#d6c2c4"
    },
  },
  "modules": [
    "break",
    {
      "type": "os", //这是哪个module
      "key": "OS", //module名字的显示
      // "keyColor": "#00ff00",      //module名字颜色
      // "format": "{name} {version}",    //具体内容
      "keyColor": "#ffb1c1",
   
    },
    {
      "type": "kernel",
      "key": " ├   KER ",
      "keyColor": "#ffb1c1",

    },
    {
      "type": "packages",
      "key": " ├   PAK ",
      "format": "{all}",
      "keyColor": "#ffb1c1",
    },
    {
      "type": "title",
      "key": " └   USR ",
      "keyColor": "#ffb1c1",
    },
    "break",
    "break",
    {
      "type": "wm",
      "key": "WM",
      "keyColor": "#ecbe91",
   },
    {
      "type": "de",
      "key": " ├ 󱈹  DES ",
      "keyColor": "#ecbe91",
     //"outputColor": "#ecbe91"
    },
    {
      "type": "shell",
      "key": " ├   SHE ",
      "keyColor": "#ecbe91",
      //"outputColor": "#ecbe91"
    },
    {
      "type": "terminal",
      "key": " ├   TER ",
      "keyColor": "#ecbe91",
      //"outputColor": "#ecbe91"
    },
    {
      "type": "terminalfont",
      "key": " └   TFO ",
      "keyColor": "#ecbe91",
      //"outputColor": "#ecbe91"
    },
    "break",
    "break",
    {
      "type": "host",
      "key": "PC ",
      "keyColor": "#ffd9df",
      //"outputColor": "#e4bdc3"
    },
    {
      "type": "cpu",
      "key": " ├   CPU ",
      "keyColor": "#ffd9df",
      //"outputColor": "#e4bdc3"
    },
    {
      "type": "memory",
      "key": " ├   MEM ",
      "keyColor": "#ffd9df",
      //"outputColor": "#e4bdc3"
    },
    {
      "type": "gpu",
      "key": " ├ 󰢮  GPU ",
      "format": "{1} {2}",
      "keyColor": "#ffd9df",
      //"outputColor": "#e4bdc3"
    },
    {
      "type": "display",
      "key": " ├   MON ",
      "format": "{name} {width}x{height}@{refresh-rate} ",
      "keyColor": "#ffd9df",
      //"outputColor": "#e4bdc3"
    },
    {
      "type": "disk",
      "key": " └ 󰋊  DIS ",
      "keyColor": "#ffd9df",
      //"outputColor": "#e4bdc3"
    },
    "break",
    "break",
    "colors"
  ]
}
